# ============================================================
# 配置样例：复制为 .env 后按需修改（.env 请勿提交到仓库）
# 部署到 Docker / CNB 时，也可直接用同名环境变量注入（环境变量优先）
# ============================================================

# 应用基础配置
APP_NAME=CNB Image Bed
APP_ENV=production            # production / development
APP_DEBUG=false

# 对外访问的基础域名（拼接返回链接 / 图片外链，填 EO/ESA 加速域名或 CNB 默认域名）
PUBLIC_BASE_URL=https://img.example.com

# 数据库（SQLite，零配置，文件型）
DB_FILE=/var/www/data/app.db

# 会话与 Cookie 安全
SESSION_SAVE_PATH=/var/www/data/sessions
SESSION_LIFETIME=86400        # 会话有效期（秒）
APP_SECURE_COOKIE=false       # 生产环境处于 HTTPS 前（EO/ESA 已提供 TLS）时改为 true

# 是否开放注册（首个用户永远是管理员；关闭后仅管理员可后台建号）
ALLOW_REGISTER=false

# 文件与图片处理
MAX_FILE_SIZE=10485760        # 单文件最大字节数（默认 10MB），需 <= nginx client_max_body_size
THUMB_MAX=500                 # 默认缩略图/转换最大边长（像素）；按需转换可传 w/h 参数

# 目录（容器内）
LOCAL_STORAGE_DIR=/var/www/uploads   # 原图存储
CACHE_DIR=/var/www/cache             # 转换后图片缓存

# 默认管理员：admin / admin12345 （首次登录后务必在「管理后台」修改密码）
